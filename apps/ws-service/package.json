{
  "name": "ws-service",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "(cd ../.. && pnpm --filter @poker/engine build && pnpm --filter @poker/shared build && pnpm --filter @poker/db build) && tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@poker/db": "workspace:*",
    "@poker/engine": "workspace:*",
    "@poker/shared": "workspace:*",
    "ws": "^8.18.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
